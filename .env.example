# Copy this file to `.env.local` and fill in your own values.
# Find them in your Supabase dashboard: Project Settings -> API
#
#   Project URL      -> VITE_SUPABASE_URL
#   anon public key  -> VITE_SUPABASE_ANON_KEY
#
# Note: env variables are baked into the static bundle at build time, so the
# anon key IS visible to visitors. That is expected — it is a public key.
# Security comes from Row Level Security (see supabase/schema.sql).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
